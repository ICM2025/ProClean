<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo personalizado para el Spinner -->
    <style name="WhiteSpinnerText">
        <item name="android:textColor">@color/white</item> <!-- Color del texto -->
        <item name="android:popupTheme">@style/WhiteSpinnerPopup</item> <!-- Tema del menú desplegable -->
    </style>

    <!-- Estilo para el menú desplegable del Spinner -->
    <style name="WhiteSpinnerPopup" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColor">@color/white</item> <!-- Color del texto en el menú desplegable -->
        <item name="android:background">@color/Fondo_pantalla</item> <!-- Fondo del menú desplegable -->
    </style>
</resources>