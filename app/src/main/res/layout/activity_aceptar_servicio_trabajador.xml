<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".aceptar_servicio_trabajador"
    android:background="@color/Fondo_pantalla">

    <!-- TextView grande para "Detalles del servicio" -->
    <TextView
        android:id="@+id/tituloDetalles"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalles del servicio"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:gravity="center"/>

    <!-- ImageView para la imagen "servicio_trabajador" -->
    <ImageView
        android:id="@+id/servicioImageView"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@mipmap/servicio_trabajador"
        app:layout_constraintTop_toBottomOf="@id/tituloDetalles"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:scaleType="centerCrop"
        />

    <!-- TextView para "Dirección:" -->
    <TextView
        android:id="@+id/direccionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dirección:"
        android:textSize="18sp"
        android:textColor="@color/green"
    app:layout_constraintTop_toBottomOf="@id/servicioImageView"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginTop="24dp"
    android:layout_marginStart="16dp"/>

    <!-- TextView para la dirección -->
    <TextView
        android:id="@+id/direccionTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cra 21#127d-63 barrio la calleja"
        android:textSize="18sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/servicioImageView"
        app:layout_constraintStart_toEndOf="@id/direccionLabel"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"/>

    <!-- TextView para "Servicio:" -->
    <TextView
        android:id="@+id/servicioLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Servicio:"
        android:textSize="18sp"
        android:textColor="@color/green"
    app:layout_constraintTop_toBottomOf="@id/direccionTextView"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginTop="16dp"
    android:layout_marginStart="16dp"/>

    <!-- TextView para el tipo de servicio -->
    <TextView
        android:id="@+id/servicioTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Aseo doméstico del hogar"
        android:textSize="18sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/direccionTextView"
        app:layout_constraintStart_toEndOf="@id/servicioLabel"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"/>

    <!-- TextView para "Tiempo estimado:" -->
    <TextView
        android:id="@+id/tiempoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre del cliente:"
        android:textSize="18sp"
        android:textColor="@color/green"
    app:layout_constraintTop_toBottomOf="@id/servicioTextView"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginTop="16dp"
    android:layout_marginStart="16dp"/>

    <!-- TextView para el tiempo estimado -->
    <TextView
        android:id="@+id/tiempoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Alfredo rojas"
        android:textSize="18sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/servicioTextView"
        app:layout_constraintStart_toEndOf="@id/tiempoLabel"
        android:layout_marginTop="16dp"
        android:layout_marginStart="8dp"/>

    <!-- TextView para "Precio del servicio:" -->
    <TextView
        android:id="@+id/precioLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Precio del servicio:"
        android:textSize="18sp"
        android:textColor="@color/green"
    app:layout_constraintTop_toBottomOf="@id/tiempoTextView"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginTop="16dp"
    android:layout_marginStart="16dp"/>

    <!-- EditText para el valor del servicio -->
    <EditText
        android:id="@+id/valorEditText"
        android:layout_width="0dp"
        android:layout_height="48dp"
    android:hint="Valor del servicio"
    android:textSize="16sp"
    android:textColor="@color/white"
    android:backgroundTint="@color/white"
        android:textColorHint="@color/white"
    android:inputType="numberDecimal"
    app:layout_constraintTop_toBottomOf="@id/precioLabel"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="16dp"
    android:layout_marginHorizontal="32dp"
    android:padding="12dp"
    android:minHeight="48dp"/> <!-- Altura mínima para cumplir con accesibilidad -->

    <!-- Botón para enviar confirmación del servicio -->
    <Button
        android:id="@+id/enviarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enviar confirmación del servicio"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/botones_color"
        app:layout_constraintTop_toBottomOf="@id/valorEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>