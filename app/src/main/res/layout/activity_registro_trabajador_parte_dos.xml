<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".registro_trabajador_parte_dos"
    android:background="@color/Fondo_pantalla">

    <!-- TextView de bienvenida -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        android:text="¡Bienvenido al mundo de las oportunidades!"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TextView para "Tipo de documento" -->
    <TextView
        android:id="@+id/textView_tipo_documento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Tipo de documento:"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/textView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spinner para seleccionar el tipo de documento -->
    <Spinner
        android:id="@+id/spinner_tipo_documento"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="40dp"
        android:backgroundTint="@color/white"
        android:textColor="@color/white"
        android:popupBackground="@color/Fondo_pantalla"
        android:spinnerMode="dropdown"
        android:theme="@style/WhiteSpinnerText"
        app:layout_constraintTop_toBottomOf="@+id/textView_tipo_documento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TextView para "Número de documento" -->
    <TextView
        android:id="@+id/textView_numero_documento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Número de documento:"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/spinner_tipo_documento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EditText para ingresar el número de documento -->
    <EditText
        android:id="@+id/editText_numero_documento"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="40dp"
        android:backgroundTint="@color/white"
        android:hint="Ingresa tu número de documento"
        android:inputType="number"
        android:padding="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/textView_numero_documento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TextView para "Fecha de expedición" -->
    <TextView
        android:id="@+id/textView_fecha_expedicion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Fecha de nacimento:"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@+id/editText_numero_documento"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spinner para seleccionar el día -->
    <Spinner
        android:id="@+id/spinner_dia"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="@color/white"
        android:popupBackground="@color/Fondo_pantalla"
        android:spinnerMode="dropdown"
        android:textColor="@color/white"
        android:theme="@style/WhiteSpinnerText"
        app:layout_constraintTop_toBottomOf="@+id/textView_fecha_expedicion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/spinner_mes" />

    <!-- Spinner para seleccionar el mes -->
    <Spinner
        android:id="@+id/spinner_mes"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/white"
        android:popupBackground="@color/Fondo_pantalla"
        android:spinnerMode="dropdown"
        android:theme="@style/WhiteSpinnerText"
        app:layout_constraintTop_toBottomOf="@+id/textView_fecha_expedicion"
        app:layout_constraintStart_toEndOf="@+id/spinner_dia"
        app:layout_constraintEnd_toStartOf="@+id/spinner_anio" />

    <!-- Spinner para seleccionar el año -->
    <Spinner
        android:id="@+id/spinner_anio"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:textColor="@color/white"
        android:backgroundTint="@color/white"
        android:popupBackground="@color/Fondo_pantalla"
        android:spinnerMode="dropdown"
        android:theme="@style/WhiteSpinnerText"
        app:layout_constraintTop_toBottomOf="@+id/textView_fecha_expedicion"
        app:layout_constraintStart_toEndOf="@+id/spinner_mes"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Botón "Siguiente" -->
    <Button
        android:id="@+id/btn_siguiente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="32dp"
        android:text="Siguiente"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/botones_color"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/spinner_anio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>