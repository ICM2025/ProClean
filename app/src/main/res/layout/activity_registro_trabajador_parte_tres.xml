<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".registro_trabajador_parte_tres"
    android:background="@color/Fondo_pantalla">

    <!-- TextView para "¿Cuál es tu profesión?" -->
    <TextView
        android:id="@+id/textView_profesion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        android:text="¿Cuál es tu profesión?"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Spinner para seleccionar la profesión -->
    <Spinner
        android:id="@+id/spinner_profesion"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="40dp"
        android:backgroundTint="@color/white"
        android:popupBackground="@color/Fondo_pantalla"
        android:spinnerMode="dropdown"
        android:theme="@style/WhiteSpinnerText"
        app:layout_constraintTop_toBottomOf="@+id/textView_profesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- TextView para "Descripción de tu trabajo" -->
    <TextView
        android:id="@+id/textView_descripcion_trabajo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="24dp"
        android:text="Descripción de tu trabajo"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@+id/spinner_profesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- EditText grande para ingresar la descripción del trabajo -->
    <EditText
        android:id="@+id/editText_descripcion_trabajo"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="start"
        android:hint="Escribe aquí la descripción de tu trabajo..."
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/white"
        app:layout_constraintTop_toBottomOf="@+id/textView_descripcion_trabajo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Botón "Siguiente" -->
    <Button
        android:id="@+id/btn_siguiente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="32dp"
        android:text="Siguiente"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="@color/botones_color"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/editText_descripcion_trabajo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>