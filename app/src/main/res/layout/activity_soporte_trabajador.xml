<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".soporte_trabajador"
    android:background="@color/Fondo_pantalla">

    <!-- TextView grande "Soporte" -->
    <TextView
        android:id="@+id/tituloSoporte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Soporte"
        android:textSize="28sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:gravity="center"/>

    <!-- TextView "Escriba su inquietud" -->
    <TextView
        android:id="@+id/inquietudLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Escriba su inquietud"
        android:textSize="18sp"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/tituloSoporte"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"/>

    <!-- EditText para escribir la inquietud -->
    <EditText
        android:id="@+id/inquietudEditText"
        android:layout_width="0dp"
        android:layout_height="150dp"
    android:hint="Escriba aquí..."
    android:textSize="16sp"
    android:textColor="@color/white"
    android:backgroundTint="@color/white"
    android:inputType="textMultiLine"
    android:gravity="start|top"
    android:padding="16dp"
        android:textColorHint="@color/white"
    app:layout_constraintTop_toBottomOf="@id/inquietudLabel"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_marginTop="16dp"
    android:layout_marginHorizontal="24dp"/>

    <!-- Botón "Enviar a soporte" -->
    <Button
        android:id="@+id/enviarSoporteButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enviar a soporte"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/botones_color"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/inquietudEditText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="40dp"
        android:padding="16dp"/>

    <!-- Botón "Volver al menú" -->
    <Button
        android:id="@+id/volverMenuButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Volver al menú"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/botones_color"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/enviarSoporteButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="40dp"
        android:padding="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>