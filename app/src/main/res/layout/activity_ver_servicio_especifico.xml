<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ver_servicio_especifico"
    android:background="@color/Fondo_pantalla">

    <!-- TextView inicial "Servicio Especifico Resumen" -->
    <TextView
        android:id="@+id/tituloServicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Servicio Especifico Resumen"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:gravity="center"/>

    <!-- TextView para "ID:" en color verde -->
    <TextView
        android:id="@+id/idLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID:"
        android:textSize="18sp"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tituloServicio"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"/>

    <!-- TextView para el valor del ID -->
    <TextView
        android:id="@+id/idValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="001"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/idLabel"
        app:layout_constraintStart_toEndOf="@id/idLabel"
        android:layout_marginStart="8dp"/>

    <!-- TextView para "Cliente:" en color verde -->
    <TextView
        android:id="@+id/clienteLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cliente:"
        android:textSize="18sp"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/idLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>

    <!-- TextView para el nombre del cliente -->
    <TextView
        android:id="@+id/clienteValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Juan Pérez"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/clienteLabel"
        app:layout_constraintStart_toEndOf="@id/clienteLabel"
        android:layout_marginStart="8dp"/>

    <!-- TextView para "Precio:" en color verde -->
    <TextView
        android:id="@+id/precioLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Precio:"
        android:textSize="18sp"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/clienteLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>

    <!-- TextView para el valor del precio -->
    <TextView
        android:id="@+id/precioValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="50,000"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/precioLabel"
        app:layout_constraintStart_toEndOf="@id/precioLabel"
        android:layout_marginStart="8dp"/>

    <!-- TextView para "Fecha:" en color verde -->
    <TextView
        android:id="@+id/fechaLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fecha:"
        android:textSize="18sp"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/precioLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp"
        android:layout_marginStart="24dp"/>

    <!-- TextView para el valor de la fecha -->
    <TextView
        android:id="@+id/fechaValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="15/03/2024"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/fechaLabel"
        app:layout_constraintStart_toEndOf="@id/fechaLabel"
        android:layout_marginStart="8dp"/>

    <!-- TextView "Ubicación:" en color verde -->
    <TextView
        android:id="@+id/ubicacionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ubicación:"
        android:textSize="18sp"
        android:textColor="@color/green"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/fechaLabel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="24dp"/>

    <!-- ImageView para la imagen "servicio_trabajador" -->
    <ImageView
        android:id="@+id/servicioImageView"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:src="@mipmap/servicio_trabajador"
        android:scaleType="centerCrop"

        app:layout_constraintTop_toBottomOf="@id/ubicacionLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp"/>

    <!-- Botón "Volver al historial de servicios" -->
    <Button
        android:id="@+id/volverHistorialButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Volver al historial de servicios"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/botones_color"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/servicioImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="40dp"
        android:padding="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>